# Token of the constructor bot (the one users talk to to create their own bots).
# Get it from @BotFather.
FACTORY_BOT_TOKEN=123456:your_constructor_bot_token_here

# SQLAlchemy URL for the database.
# Default: SQLite in ./data/factory.db (created automatically).
# For docker-compose use: sqlite+aiosqlite:////data/factory.db
DATABASE_URL=sqlite+aiosqlite:///./data/factory.db

# Optional comma-separated list of Telegram user IDs allowed to use the
# constructor bot. Leave empty to allow everyone.
ALLOWED_OWNER_IDS=

# Logging level (DEBUG / INFO / WARNING / ERROR).
LOG_LEVEL=INFO

# Optional proxy for Telegram API requests.
# Useful when api.telegram.org is unavailable from your network.
# Examples: http://user:pass@host:port or socks5://user:pass@host:port
TELEGRAM_PROXY_URL=

# ---- Claude / Anthropic support chat ---------------------------------------
# Comma-separated Anthropic API keys. The support-chat feature in child bots
# tries them in order — when one is rate-limited (HTTP 429), out of credit
# (402) or invalid (401/403), it transparently rotates to the next one.
# Leave empty to disable the support chat entirely.
CLAUDE_API_KEYS=

# Anthropic model name. Default targets the latest available Opus.
# See https://docs.anthropic.com/en/docs/about-claude/models for valid IDs.
CLAUDE_MODEL=claude-opus-4-5

# API base URL. Override this only if you proxy Anthropic through your own
# gateway (e.g. https://my-proxy.example.com).
CLAUDE_BASE_URL=https://api.anthropic.com

# Value of the `anthropic-version` header.
CLAUDE_ANTHROPIC_VERSION=2023-06-01

# Maximum tokens to generate in a single Claude reply.
CLAUDE_MAX_TOKENS=1024

# How many of the most recent (user, assistant) pairs to keep in the chat
# context window. Older messages are dropped on every turn.
CLAUDE_HISTORY_LIMIT=10

# HTTP timeout (seconds) for a single Claude API call.
CLAUDE_TIMEOUT_SECONDS=60

# Optional override for the support-chat system prompt. Empty falls back to a
# built-in restaurant-support prompt that mentions the venue name and details.
CLAUDE_SYSTEM_PROMPT=

# ---- Devin (api.devin.ai) chat backend ------------------------------------
# Alternative chat backend that uses Devin sessions instead of Anthropic.
# Comma-separated Devin API keys (apk_* legacy or cog_* current). Each guest
# turn opens / continues a Devin session, polled until the agent replies.
# Devin is *much* slower (seconds-to-minutes per reply) and costs ACUs —
# prefer Claude when possible. Leave empty to skip this backend.
DEVIN_API_KEYS=

# Devin API base URL.
DEVIN_BASE_URL=https://api.devin.ai

# How often (seconds) to poll a Devin session while waiting for a reply.
DEVIN_POLL_INTERVAL_SECONDS=5

# Maximum time (seconds) to wait for a single Devin reply before giving up.
DEVIN_RESPONSE_TIMEOUT_SECONDS=180

# Optional ACU cap for each Devin support session. 0 = use the org default.
DEVIN_MAX_ACU_LIMIT=0

# Which backend powers the support chat: `claude`, `devin`, or `auto` (prefer
# Claude, fall back to Devin if only DEVIN_API_KEYS are set).
SUPPORT_BACKEND=auto
